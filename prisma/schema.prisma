// PolyQuant Terminal — database schema
// PostgreSQL via Prisma. The app runs without a database (in-memory store with
// JSON file persistence) when DATABASE_URL is not set; set STORAGE_DRIVER=prisma
// and DATABASE_URL to persist to Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  displayName     String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallets  Wallet[]
  settings AppSetting[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  chainId   Int      @default(137)
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Market {
  conditionId String    @id
  gammaId     String?   @unique
  slug        String?
  question    String
  description String?
  category    String?
  tags        String[]  @default([])
  endDate     DateTime?
  active      Boolean   @default(true)
  closed      Boolean   @default(false)
  negRisk     Boolean   @default(false)
  liquidity   Float     @default(0)
  volume24h   Float     @default(0)
  volumeTotal Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  outcomes  Outcome[]
  snapshots MarketSnapshot[]
  signals   Signal[]

  @@index([active, closed])
  @@index([endDate])
  @@map("markets")
}

model Outcome {
  id      String @id @default(cuid())
  marketId String
  tokenId String @unique
  label   String
  index   Int    @default(0)

  market Market @relation(fields: [marketId], references: [conditionId], onDelete: Cascade)

  @@map("outcomes")
}

model MarketSnapshot {
  id        String   @id @default(cuid())
  marketId  String
  ts        DateTime @default(now())
  yesPrice  Float?
  noPrice   Float?
  bestBid   Float?
  bestAsk   Float?
  midpoint  Float?
  spread    Float?
  liquidity Float?
  volume24h Float?

  market Market @relation(fields: [marketId], references: [conditionId], onDelete: Cascade)

  @@index([marketId, ts])
  @@map("market_snapshots")
}

model OrderBook {
  id      String   @id @default(cuid())
  tokenId String
  ts      DateTime @default(now())
  hash    String?
  bids    Json
  asks    Json

  @@index([tokenId, ts])
  @@map("order_books")
}

model PriceHistory {
  id      String   @id @default(cuid())
  tokenId String
  ts      DateTime
  price   Float

  @@unique([tokenId, ts])
  @@index([tokenId])
  @@map("price_history")
}

model Signal {
  id          String    @id @default(cuid())
  strategy    String
  marketId    String?
  conditionId String?
  tokenId     String?
  direction   String? // BUY_YES | BUY_NO | NEUTRAL
  score       Float
  status      String    @default("proposed") // proposed | approved | rejected | expired
  summary     String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  market Market?       @relation(fields: [marketId], references: [conditionId], onDelete: SetNull)
  checks SignalCheck[]

  @@index([strategy, createdAt])
  @@index([status])
  @@map("signals")
}

model SignalCheck {
  id        String  @id @default(cuid())
  signalId  String
  name      String
  passed    Boolean
  value     Float?
  threshold Float?
  detail    String?

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("signal_checks")
}

model PaperOrder {
  id           String    @id @default(cuid())
  mode         String    @default("paper") // paper | demo
  conditionId  String?
  tokenId      String
  outcome      String?
  marketTitle  String?
  category     String?
  origin       String? // manual | autopilot
  side         String // BUY | SELL
  orderType    String    @default("limit") // limit | market
  price        Float
  size         Float
  filledSize   Float     @default(0)
  avgFillPrice Float?
  status       String    @default("created") // created | open | partially_filled | filled | canceled | rejected | expired
  signalId     String?
  reason       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?

  fills Fill[]

  @@index([status])
  @@index([tokenId])
  @@map("paper_orders")
}

model LiveOrderIntent {
  id               String    @id @default(cuid())
  conditionId      String?
  tokenId          String
  outcome          String?
  marketTitle      String?
  origin           String? // manual | autopilot
  side             String
  orderType        String    @default("limit")
  price            Float
  size             Float
  filledSize       Float     @default(0)
  status           String    @default("created") // created | previewed | approval_required | confirmed | signed | submitted | open | partially_filled | filled | canceled | rejected | expired
  confirmationText String?
  approvedAt       DateTime?
  clobOrderId      String?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime?

  fills Fill[]

  @@index([status])
  @@map("live_order_intents")
}

model Fill {
  id               String   @id @default(cuid())
  orderId          String?
  intentId         String?
  mode             String   @default("paper")
  tokenId          String
  conditionId      String?
  outcome          String?
  marketTitle      String?
  category         String?
  side             String
  price            Float
  size             Float
  fee              Float    @default(0)
  realizedPnlDelta Float?
  ts               DateTime @default(now())

  order  PaperOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  intent LiveOrderIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([tokenId, ts])
  @@map("fills")
}

model Position {
  id           String   @id @default(cuid())
  mode         String   @default("paper")
  conditionId  String?
  tokenId      String
  outcome      String?
  marketTitle  String?
  category     String?
  size         Float    @default(0)
  avgPrice     Float    @default(0)
  realizedPnl  Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tokenId, mode])
  @@map("positions")
}

model PortfolioSnapshot {
  id            String   @id @default(cuid())
  ts            DateTime @default(now())
  mode          String
  totalValue    Float
  cash          Float
  exposure      Float
  realizedPnl   Float
  unrealizedPnl Float
  dailyPnl      Float
  drawdown      Float

  @@index([mode, ts])
  @@map("portfolio_snapshots")
}

model RiskSnapshot {
  id                    String   @id @default(cuid())
  ts                    DateTime @default(now())
  mode                  String
  dailyLossUsed         Float
  exposurePct           Float
  liquidityRiskScore    Float
  killSwitch            Boolean  @default(false)
  marketConcentration   Json?
  categoryConcentration Json?

  @@index([mode, ts])
  @@map("risk_snapshots")
}

model AuditEvent {
  id       String   @id @default(cuid())
  ts       DateTime @default(now())
  actor    String   @default("system") // system | user | scanner | risk | execution
  type     String
  severity String   @default("info") // info | warn | error
  message  String
  data     Json?

  @@index([ts])
  @@index([type])
  @@map("audit_events")
}

model Venue {
  id                 String    @id // polymarket | kalshi | coinbase | coingecko
  name               String
  type               String // prediction | regulated_event | crypto_spot | reference
  enabled            Boolean   @default(true)
  publicDataEnabled  Boolean   @default(true)
  privateDataEnabled Boolean   @default(false)
  paperTradingEnabled Boolean  @default(true)
  liveTradingEnabled Boolean   @default(false)
  lastHealthCheck    DateTime?
  status             String    @default("unknown")

  credentials VenueCredential[]
  health      VenueHealth[]

  @@map("venues")
}

model VenueCredential {
  id                     String    @id @default(cuid())
  userId                 String?
  venueId                String
  credentialType         String // api_key | oauth | signing_key
  /** reference to an EXTERNAL secret (env var name / vault path) — raw
   * secrets are never stored in this database */
  encryptedCredentialRef String
  scopes                 String[]  @default([])
  createdAt              DateTime  @default(now())
  lastUsedAt             DateTime?
  revokedAt              DateTime?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_credentials")
}

model NormalizedMarketRow {
  id              String    @id // internal key (conditionId / ks:… / cb:…)
  venueId         String
  venueMarketId   String
  ticker          String?
  title           String
  category        String?
  status          String    @default("active")
  closeTime       DateTime?
  resolutionRules String?
  tradable        Boolean   @default(true)
  referenceOnly   Boolean   @default(false)
  metadata        Json?
  updatedAt       DateTime  @updatedAt

  @@index([venueId])
  @@map("normalized_markets")
}

model CrossVenueLink {
  id             String   @id @default(cuid())
  sourceVenueId  String
  sourceMarketId String
  targetVenueId  String
  targetMarketId String
  matchScore     Float
  matchStatus    String
  ruleComparison Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceMarketId])
  @@index([targetMarketId])
  @@map("cross_venue_links")
}

model ReferencePriceRow {
  id          String   @id @default(cuid())
  source      String
  symbol      String
  price       Float
  bid         Float?
  ask         Float?
  volume      Float?
  timestamp   DateTime
  freshnessMs Int

  @@index([source, symbol, timestamp])
  @@map("reference_prices")
}

model VenueHealth {
  id                 String   @id @default(cuid())
  venueId            String
  restStatus         String   @default("unknown")
  websocketStatus    String   @default("unknown")
  latencyP50         Float?
  latencyP95         Float?
  latencyP99         Float?
  errorRate          Float?
  rateLimitRemaining Int?
  lastUpdated        DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, lastUpdated])
  @@map("venue_health")
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("app_settings")
}

// ── Alpha Foundry ─────────────────────────────────────────────────────────────

model SourceRegistryRow {
  sourceId              String    @id
  sourceName            String
  category              String
  baseUrl               String
  docsUrl               String?
  officialSource        Boolean   @default(false)
  freeAvailable         Boolean   @default(true)
  apiKeyRequired        Boolean   @default(false)
  authenticationType    String    @default("none")
  rateLimit             String?
  latencyEstimateMs     Int?
  updateFrequency       String?
  historicalDepth       String?
  allowedUse            String?
  prohibitedUse         String?
  commercialUseAllowed  String    @default("unknown")
  redistributionAllowed String    @default("unknown")
  reliabilityScore      Float     @default(0.5)
  freshnessScore        Float?
  signalCategories      String[]  @default([])
  marketCategories      String[]  @default([])
  lastSuccessfulCall    DateTime?
  lastFailedCall        DateTime?
  lastTermsReview       DateTime?
  status                String    @default("disabled")
  note                  String?

  @@map("source_registry")
}

model TrackedWalletRow {
  walletId       String    @id // lowercase public proxy-wallet address
  pseudonym      String? // venue-published display name only — never inferred identity
  label          String    @default("low_sample_unknown")
  labels         String[]  @default([])
  firstSeen      DateTime  @default(now())
  lastSeen       DateTime  @updatedAt
  manuallyAdded  Boolean   @default(false)
  autoDiscovered Boolean   @default(true)
  status         String    @default("candidate")
  rejectReason   String?
  candidateScore Float?
  totalClosed    Int       @default(0)
  totalPnl       Float     @default(0)
  costAdjRoi     Float     @default(0)
  forwardJson    Json?
  notes          String?
  lastScoredAt   DateTime?

  trades WalletTradeRow[]
  skills WalletSkillScoreRow[]

  @@map("tracked_wallets")
}

model WalletTradeRow {
  id              String   @id @default(cuid())
  walletId        String
  venue           String   @default("polymarket")
  conditionId     String
  asset           String
  outcome         String?
  side            String
  size            Float
  price           Float
  ts              DateTime
  transactionHash String?
  marketTitle     String?
  eventSlug       String?
  category        String?
  closeTime       DateTime?

  wallet TrackedWalletRow @relation(fields: [walletId], references: [walletId], onDelete: Cascade)

  @@index([walletId, ts])
  @@map("wallet_trades")
}

model WalletPositionRow {
  id            String   @id @default(cuid())
  walletId      String
  conditionId   String
  outcome       String?
  size          Float
  avgEntry      Float
  markPrice     Float?
  realizedPnl   Float    @default(0)
  unrealizedPnl Float?
  totalPnl      Float?
  status        String   @default("open")
  updatedAt     DateTime @updatedAt

  @@index([walletId])
  @@map("wallet_positions")
}

model WalletSkillScoreRow {
  id                     String   @id @default(cuid())
  walletId               String
  dimension              String // cat:crypto | dur:short | liq:low | …
  sampleSize             Int      @default(0)
  realizedRoi            Float    @default(0)
  costAdjRoi             Float    @default(0)
  winRate                Float    @default(0)
  profitFactor           Float    @default(0)
  maxDrawdown            Float    @default(0)
  copyableRoi            Float?
  fadeRoi                Float?
  entryTimingScore       Float?
  exitTimingScore        Float?
  liquidityAdjustedScore Float?
  slippageAdjustedScore  Float?
  confidence             Float    @default(0)
  updatedAt              DateTime @updatedAt

  wallet TrackedWalletRow @relation(fields: [walletId], references: [walletId], onDelete: Cascade)

  @@unique([walletId, dimension])
  @@map("wallet_skill_scores")
}

model WalletSignalRow {
  id                String   @id @default(cuid())
  walletId          String
  conditionId       String
  signalType        String
  direction         String
  walletEntryPrice  Float?
  currentPrice      Float?
  priceDrift        Float?
  mimicabilityScore Float?
  categoryFit       Float?
  remainingEdge     Float?
  liquidityScore    Float?
  ruleClarity       Float?
  crowdingPenalty   Float?
  recommendation    String?
  createdAt         DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_signals")
}

model AlphaFeatureRow {
  id              String    @id
  name            String
  thesis          String
  dataSources     String[]  @default([])
  categoryScope   String[]  @default([])
  status          String    @default("idea")
  alphaScore      Float?
  componentsJson  Json?
  killCriteria    String?
  failureReason   String?
  failureClass    String?
  lessons         String?
  revisitable     Boolean?
  humanApprovedAt DateTime?
  humanApprovedBy String?
  promotedAt      DateTime?
  retiredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("alpha_features")
}

model AlphaOutcomeRow {
  id              String   @id @default(cuid())
  featureId       String
  signalId        String
  conditionId     String
  direction       String
  entryMid        Float
  spreadAtSignal  Float?
  bookAgeMs       Int?
  tradable        Boolean  @default(false)
  wasProposed     Boolean  @default(false)
  walletId        String?
  bucketsJson     Json
  createdAt       DateTime @default(now())

  @@index([featureId, createdAt])
  @@map("alpha_outcomes")
}

model DisclosureRow {
  id              String   @id
  source          String
  docType         String?
  title           String
  url             String
  filingDate      String
  transactionDate String?
  lagDays         Float?
  agency          String?
  sector          String?
  policyTags      String[] @default([])
  relatedJson     Json?
  confidence      Float    @default(0)
  humanReview     Boolean  @default(true)
  fetchedAt       DateTime @default(now())

  @@map("disclosures")
}

model ResearchIdeaRow {
  id              String   @id
  title           String
  marketCategory  String?
  dataSource      String?
  accessMethod    String?
  expectedLatency String?
  alphaThesis     String?
  risks           String?
  termsConcerns   String?
  backtestMethod  String?
  paperTestPlan   String?
  killCriteria    String?
  status          String   @default("proposed")
  createdAt       DateTime @default(now())

  @@map("research_ideas")
}
