# ── PolyQuant Terminal environment template ──────────────────────────────────
# Copy to .env.local (Next.js) or .env and fill in what you need.
# Everything is optional: with no configuration the app runs in DEMO mode with
# real public market data and clearly-labeled sample account data.

# ── Storage ───────────────────────────────────────────────────────────────────
# "memory" (default): in-process store persisted to .data/polyquant-store.json.
# "prisma": PostgreSQL via Prisma. Requires DATABASE_URL and `npm run db:migrate`.
STORAGE_DRIVER=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polyquant

# ── Cache / rate-limit protection ────────────────────────────────────────────
# Optional Redis for shared caching across processes. Falls back to in-memory.
REDIS_URL=

# ── Polymarket public endpoints (defaults are the official production hosts) ─
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
# Public market-channel websocket (client-side)
NEXT_PUBLIC_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── Read-only wallet analytics ───────────────────────────────────────────────
# A Polygon address (proxy wallet) used only for read-only position/trade
# analytics via the public Data API. No keys involved.
NEXT_PUBLIC_WATCH_WALLET=

# ── Live trading (OFF by default — read SECURITY notes in README first) ─────
# Live trading stays fully locked unless ALL of the following are true:
#   1. LIVE_TRADING_ENABLED=true here,
#   2. the user enables Live mode in Settings → API/Wallet,
#   3. the user confirms each order in the preview modal (typed confirmation
#      above the configured notional threshold).
LIVE_TRADING_ENABLED=false

# CLOB L2 API credentials (created via the official Polymarket CLOB client).
# Only needed for live order placement / cancellation. Stored server-side only.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# Funder address (Polymarket proxy wallet) used by the CLOB client.
POLY_FUNDER_ADDRESS=

# NEVER paste a raw private key you care about into a .env file.
# The recommended setup is browser-side signing. This variable exists only for
# isolated, throwaway operational wallets and is intentionally left blank.
POLY_SIGNER_PRIVATE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Encryption key for credentials at rest when using the prisma store (32 bytes,
# base64). Generate: `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
